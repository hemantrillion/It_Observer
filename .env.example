# ==============================================================================
# InfraTrace Observability Platform - Environment Variables Template
# Copy this file to .env.local and configure your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (Required for Google Authentication)
# ------------------------------------------------------------------------------
# 1. Go to Google Cloud Console: https://console.cloud.google.com/
# 2. Create a new project or select an existing one.
# 3. Configure the OAuth Consent Screen (External, add email, userinfo scopes).
# 4. Under 'Credentials', click 'Create Credentials' -> 'OAuth client ID'.
# 5. Application type: 'Web application'.
# 6. Authorized JavaScript origins:
#      http://localhost:3000
#      https://your-production-domain.com
# 7. Authorized redirect URIs:
#      http://localhost:3000/api/auth/google/callback
#      https://your-production-domain.com/api/auth/google/callback
# 8. Copy Client ID and Client Secret into the variables below.
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Session & Security Settings
# ------------------------------------------------------------------------------
# A random secret string used to sign HMAC-SHA256 session cookies.
# Generate one using: openssl rand -base64 32
AUTH_SECRET=your-random-production-auth-secret-key-at-least-32-chars

# Base application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

